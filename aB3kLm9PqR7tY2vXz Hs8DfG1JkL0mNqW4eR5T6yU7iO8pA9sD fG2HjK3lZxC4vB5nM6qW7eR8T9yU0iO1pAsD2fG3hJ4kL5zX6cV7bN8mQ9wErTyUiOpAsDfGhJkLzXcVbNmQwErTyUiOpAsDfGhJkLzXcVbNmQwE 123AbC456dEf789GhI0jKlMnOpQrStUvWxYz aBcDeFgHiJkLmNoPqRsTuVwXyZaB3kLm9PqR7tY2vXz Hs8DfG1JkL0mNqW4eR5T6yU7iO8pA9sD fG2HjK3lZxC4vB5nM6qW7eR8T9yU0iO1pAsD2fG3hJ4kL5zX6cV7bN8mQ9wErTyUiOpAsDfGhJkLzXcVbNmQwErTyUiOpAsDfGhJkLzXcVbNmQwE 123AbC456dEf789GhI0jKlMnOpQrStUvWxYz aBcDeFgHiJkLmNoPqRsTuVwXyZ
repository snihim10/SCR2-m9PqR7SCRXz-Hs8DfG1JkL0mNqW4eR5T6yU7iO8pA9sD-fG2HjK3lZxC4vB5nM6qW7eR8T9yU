local function cleanupOldGui()
	local roots = {}
	local okHui, hui = pcall(function()
		if type(gethui) == "function" then
			return gethui()
		end
	end)
	if okHui and hui then
		table.insert(roots, hui)
	end
	table.insert(roots, PLAYER_GUI)
	for _, root in ipairs(roots) do
		local existing = root and root:FindFirstChild(GUI_NAME)
		if existing then
			existing:Destroy()
		end
	end
end

cleanupOldGui()

local function readSavedLanguage()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return nil
	end
	local okExists, exists = pcall(isfile, LANGUAGE_FILE)
	if not okExists or not exists then
		return nil
	end
	local okRead, raw = pcall(readfile, LANGUAGE_FILE)
	if not okRead or type(raw) ~= "string" then
		return nil
	end
	local clean = raw:match("^%s*(.-)%s*$")
	if TEXTS[clean] then
		return clean
	end
	return nil
end

local function saveLanguage(lang)
	if type(writefile) ~= "function" or not TEXTS[lang] then
		return false
	end
	return pcall(writefile, LANGUAGE_FILE, lang)
end

currentLanguage = readSavedLanguage() or currentLanguage

local function tr(key)
	local pack = TEXTS[currentLanguage] or TEXTS.vi
	return pack[key] or TEXTS.vi[key] or key
end

local function bindText(object, key, formatter)
	uiBindings[object] = { key = key, formatter = formatter }
	local value = tr(key)
	object.Text = formatter and formatter(value) or value
end

local function setZIndexRecursive(rootObject, zIndex)
	if not rootObject then
		return
	end
	pcall(function()
		rootObject.ZIndex = zIndex
	end)
	for _, child in ipairs(rootObject:GetDescendants()) do
		pcall(function()
			child.ZIndex = zIndex
		end)
	end
end

local function refreshTexts()
	for object, info in pairs(uiBindings) do
		if object and object.Parent then
			local value = tr(info.key)
			object.Text = info.formatter and info.formatter(value) or value
		end
	end
	for lang, button in pairs(langButtons) do
		if button and button.Parent then
			local active = lang == currentLanguage
			button.BackgroundColor3 = active and Color3.fromRGB(73, 176, 255) or Color3.fromRGB(18, 30, 49)
			button.TextColor3 = active and Color3.fromRGB(11, 19, 31) or Color3.fromRGB(220, 231, 245)
		end
	end
end

